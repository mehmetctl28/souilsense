{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "pairingCodes": {
      "$sensorId": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists()"
      }
    },
    "sensorOwners": {
      "$sensorId": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && root.child('pairingCodes').child($sensorId).exists()"
      }
    },
    "sensors": {
      "$sensorId": {
        ".read": "auth != null && root.child('sensorOwners').child($sensorId).val() == auth.uid",
        ".write": "auth != null && root.child('sensorOwners').child($sensorId).val() == auth.uid"
      }
    },
    "pumpCommands": {
      "$sensorId": {
        ".read": "auth != null && root.child('sensorOwners').child($sensorId).val() == auth.uid",
        ".write": "auth != null && root.child('sensorOwners').child($sensorId).val() == auth.uid"
      }
    },
    "sensorConfigs": {
      "$sensorId": {
        ".read": "auth != null && root.child('sensorOwners').child($sensorId).val() == auth.uid",
        ".write": "auth != null && root.child('sensorOwners').child($sensorId).val() == auth.uid"
      }
    }
  }
}